# Copy this file to .env and fill in real values. Expo inlines any variable
# prefixed with EXPO_PUBLIC_ into the JS bundle at build time - no other
# wiring needed (see lib/env.ts).

# Supabase project (same project the Next.js web app uses).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Next.js app's URL.
#
# - iOS Simulator / Android Emulator on the SAME machine as `next dev`, or
#   `expo start --web`: http://localhost:3000 works.
# - A physical device, or an Android emulator that can't reach the host's
#   localhost: use your dev machine's LAN IP instead, e.g.
#   http://192.168.1.20:3000 (find it with `ipconfig` on Windows or
#   `ifconfig`/`ip addr` on macOS/Linux). Both devices must be on the same
#   network, and the Next.js dev server must be started with a host that
#   accepts LAN connections (`next dev -H 0.0.0.0`).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
