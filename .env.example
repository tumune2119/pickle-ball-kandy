# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your_service_role_key

# PayHere Payment Gateway (optional for MVP, can use "pay at venue" initially)
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout  # Use https://www.payhere.lk/pay/checkout for production

# Email Notifications (optional - Supabase can handle basic emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# App Configuration
NEXT_PUBLIC_CURRENCY=LKR
NEXT_PUBLIC_TIMEZONE=Asia/Colombo
NEXT_PUBLIC_COURT_ID=kandy-1st-court
NEXT_PUBLIC_APP_NAME=Kandy 1st Court
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin credentials (for initial setup only)
ADMIN_EMAIL=admin@kandypickleball.lk
ADMIN_PHONE=+94712345678
ADMIN_PASSWORD=change_me_in_production
